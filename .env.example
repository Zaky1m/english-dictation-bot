# Telegram bot token from BotFather
BOT_TOKEN=123456:replace-me
# Public HTTPS origin of the Mini App, no trailing slash
PUBLIC_URL=https://example.com
# Address the HTTP server listens on; when empty, 0.0.0.0:$PORT is used
BIND_ADDR=127.0.0.1:4510
# PostgreSQL connection string
DATABASE_URL=postgresql://eng:password@127.0.0.1:5432/eng
# Secret path segment of the webhook URL (random hex)
WEBHOOK_PATH=replace-with-random-hex
# Value Telegram sends in X-Telegram-Bot-Api-Secret-Token (random hex)
WEBHOOK_SECRET=replace-with-random-hex
# Secret path segment of the Adsgram reward callback (random hex)
ADSGRAM_REWARD_SECRET=replace-with-random-hex
# Rewarded ad networks. Fill in the ones you use; the app tries them in the
# order of the ad_provider_order setting and skips any left empty.
# Adsgram block id (needs the reward callback set in the Adsgram dashboard)
ADSGRAM_BLOCK_ID=
# Monetag zone id
MONETAG_ZONE_ID=
# Adexium widget id
ADEXIUM_WIDGET_ID=
# Telega.io token and ad block uuid
TELEGA_TOKEN=
TELEGA_AD_BLOCK_UUID=
# GigaPub project id
GIGAPUB_PROJECT_ID=
# Comma-separated Telegram user ids allowed into the admin panel
ADMIN_IDS=
# Telegram username (without @) that receives manual payment chats; button hidden while empty
ADMIN_USERNAME=
# Channel id for the daily challenge summary; posting is off while empty
CHALLENGE_CHANNEL_ID=
# Directory holding generated MP3 files
DATA_DIR=data
# Directory holding the static Mini App
WEB_DIR=web
# Gemini API keys, used round-robin: GEMINI_API_KEY_1 ... GEMINI_API_KEY_<n>
GEMINI_API_KEY_1=replace-me
GEMINI_API_KEY_2=replace-me
# Optional: record audio with ElevenLabs instead of Gemini (lessons are still
# written with Gemini). Both the key and the voice id are needed.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional model, eleven_multilingual_v2 when empty
ELEVENLABS_MODEL_ID=
# Used by compose.yml only: password of the bundled PostgreSQL container
POSTGRES_PASSWORD=replace-me
