# systemd unit example. Adjust the user and the paths, then:
#   sudo cp eng.service.example /etc/systemd/system/eng.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now eng
[Unit]
Description=eng Telegram Mini App
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=eng
WorkingDirectory=/opt/eng
EnvironmentFile=/opt/eng/.env
ExecStart=/opt/eng/target/release/eng serve
Environment=TZ=Africa/Cairo
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
